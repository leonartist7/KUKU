{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/kuku-release-20261027": false,
      "codex/verify-kuku-beta-20261104-1619": false
    }
  }
}
