# Public HTTPS backend origin, no /api suffix. Never put a secret in EXPO_PUBLIC_.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_ENABLE_CALLS=false
# Server-only Vercel function environment; same API origin.
BACKEND_URL=
EXPO_PUBLIC_ENABLE_PUSH=false
# EAS project ID is public; GOOGLE_SERVICES_JSON is an EAS file environment variable.
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
